{
  "village_chief": {
    "name": "村長",
    "sdId": 133,
    "texture": "/images/npcs/village_chief.png",
    "height": 2.4,
    "aspect": 0.474,
    "radius": 0.45,
    "speed": 0.7,
    "wanderRadius": 1.0,
    "lines": [
      "よく来た、旅の人。ここは静かで、良い村じゃよ。",
      "南の橋を渡れば、東の草原へ出られる。魔物には気をつけなさい。",
      "わしの家は自由に見ていくがよい。"
    ]
  },
  "villager_man": {
    "name": "村人の男",
    "sdId": 127,
    "texture": "/images/npcs/villager_man.png",
    "height": 2.3,
    "aspect": 0.368,
    "radius": 0.45,
    "speed": 0.9,
    "wanderRadius": 3.0,
    "lines": [
      "今年は畑の出来がいい。",
      "最近、草原で魔物を見たって話だ。"
    ]
  },
  "villager_woman": {
    "name": "村人の女",
    "sdId": 128,
    "texture": "/images/npcs/villager_woman.png",
    "height": 2.2,
    "aspect": 0.381,
    "radius": 0.45,
    "speed": 0.9,
    "wanderRadius": 3.0,
    "lines": [
      "花壇の花がきれいに咲いたのよ。",
      "川の水は冷たいから、落ちないようにね。"
    ]
  },
  "child_boy": {
    "name": "村の男の子",
    "sdId": 129,
    "texture": "/images/npcs/child_boy.png",
    "height": 1.6,
    "aspect": 0.365,
    "radius": 0.35,
    "speed": 1.3,
    "wanderRadius": 3.0,
    "lines": [
      "橋のむこうに行ってみたいなあ。",
      "おにいちゃん、冒険者？ すごい！"
    ]
  },
  "child_girl": {
    "name": "村の女の子",
    "sdId": 130,
    "texture": "/images/npcs/child_girl.png",
    "height": 1.55,
    "aspect": 0.343,
    "radius": 0.35,
    "speed": 1.3,
    "wanderRadius": 3.0,
    "lines": [
      "お花をつんでもいい？ ……だめ？",
      "村長さんは、いつもやさしいんだよ。"
    ]
  },
  "elder_man": {
    "name": "村の老人",
    "sdId": 131,
    "texture": "/images/npcs/elder_man.png",
    "height": 2.1,
    "aspect": 0.396,
    "radius": 0.45,
    "speed": 0.5,
    "wanderRadius": 2.0,
    "lines": [
      "わしが若い頃は、この辺りも魔物だらけじゃった。",
      "ほっほっ、元気そうでなによりじゃ。"
    ]
  },
  "elder_woman": {
    "name": "村の老婆",
    "sdId": 132,
    "texture": "/images/npcs/elder_woman.png",
    "height": 2.0,
    "aspect": 0.36,
    "radius": 0.45,
    "speed": 0.5,
    "wanderRadius": 2.0,
    "lines": [
      "おや、旅の人かい。ゆっくりしていきなさい。",
      "腰が痛くてねぇ……天気が崩れるかもしれないよ。"
    ]
  },
  "merchant_man": {
    "name": "商人",
    "sdId": 134,
    "texture": "/images/npcs/merchant_man.png",
    "height": 2.4,
    "aspect": 0.485,
    "radius": 0.6,
    "speed": 0.7,
    "wanderRadius": 2.0,
    "lines": [
      "いい品が入っているよ。……今日は仕入れの途中でね。",
      "おっと、旦那、運がいい。また今度寄っておくれ。"
    ]
  },
  "merchant_woman": {
    "name": "商人の婦人",
    "sdId": 135,
    "texture": "/images/npcs/merchant_woman.png",
    "height": 2.5,
    "aspect": 0.406,
    "radius": 0.6,
    "speed": 0.7,
    "wanderRadius": 2.0,
    "lines": [
      "あたしの目利きは確かだよ。損はさせないさ。",
      "村の外は物騒だからね。準備はしっかりしていきな。"
    ]
  },
  "king": {
    "name": "王様",
    "sdId": 17,
    "texture": "/images/npcs/king.png",
    "height": 2.2,
    "aspect": 1.057,
    "radius": 1.0,
    "speed": 0.0,
    "wanderRadius": 0.0,
    "lines": [
      "ふむ……よくぞ参った、冒険者よ。",
      "わしは腹が減った。……いや、国の行く末が心配なだけじゃ。",
      "税を上げれば宝石が増える。簡単な話じゃろう？"
    ]
  },
  "prince": {
    "name": "王子",
    "sdId": 7,
    "texture": "/images/npcs/prince.png",
    "height": 2.3,
    "aspect": 0.624,
    "radius": 0.7,
    "speed": 0.0,
    "wanderRadius": 0.0,
    "lines": [
      "ぼくは顔がいいから、何をしても許されるんだ。",
      "勉強？ それって、おいしいの？",
      "冒険者かあ。ぼくも魔王を倒してみたいなあ……明日あたり。"
    ]
  },
  "guard_heavy": {
    "name": "重装の衛兵",
    "sdId": 16,
    "texture": "/images/npcs/guard_heavy.png",
    "height": 2.8,
    "aspect": 0.52,
    "radius": 0.8,
    "speed": 0.5,
    "wanderRadius": 1.0,
    "lines": [
      "陛下の御前だ。静かにしろ。",
      "……この国は、大丈夫なのだろうか。"
    ]
  },
  "guard_spear": {
    "name": "城の衛兵",
    "sdId": 9,
    "texture": "/images/npcs/guard_spear.png",
    "height": 2.6,
    "aspect": 0.374,
    "radius": 0.5,
    "speed": 0.6,
    "wanderRadius": 2.0,
    "lines": [
      "ここは王城だ。無礼は許さんぞ。",
      "怪しい動きをすれば、容赦はしない。"
    ]
  },
  "guard_light": {
    "name": "軽装の衛兵",
    "sdId": 2,
    "texture": "/images/npcs/guard_light.png",
    "height": 2.4,
    "aspect": 0.321,
    "radius": 0.45,
    "speed": 0.6,
    "wanderRadius": 2.0,
    "lines": [
      "見回り中だ。何か用か？",
      "城の中では、剣を抜くなよ。"
    ]
  },
  "gate_guard": {
    "name": "城門の衛兵",
    "sdId": 9,
    "texture": "/images/npcs/guard_spear.png",
    "height": 2.6,
    "aspect": 0.373,
    "radius": 0.5,
    "speed": 0.0,
    "wanderRadius": 0.0,
    "lines": [
      "ここは王城の正門だ。陛下に会うなら、静かにな。",
      "王様は……まあ、見ればわかる。",
      "通ってよし。くれぐれも、失礼のないように。"
    ]
  },
  "weapon_keeper": {
    "name": "武器屋の主人",
    "sdId": 134,
    "texture": "/images/npcs/merchant_man.png",
    "height": 2.4,
    "aspect": 0.485,
    "radius": 0.6,
    "speed": 0.0,
    "wanderRadius": 0.0,
    "lines": [
      "いらっしゃい。ご注文は？",
      "……と言いたいが、品物はまだ準備中でな。"
    ],
    "speechRadius": 9.5
  },
  "item_keeper": {
    "name": "道具屋の女将",
    "sdId": 135,
    "texture": "/images/npcs/merchant_woman.png",
    "height": 2.5,
    "aspect": 0.408,
    "radius": 0.6,
    "speed": 0.0,
    "wanderRadius": 0.0,
    "lines": [
      "いらっしゃい。ご注文は？",
      "……ごめんね、品物はまだ準備中なんだ。"
    ],
    "speechRadius": 9.5
  },
  "adv_clerk_man": {
    "name": "冒険者ギルドの受付",
    "sdId": 150,
    "texture": "/images/npcs/adv_clerk_man.png",
    "height": 2.3,
    "aspect": 0.367,
    "radius": 0.41,
    "speed": 0.0,
    "wanderRadius": 0.0,
    "lines": [
      "冒険者の登録ですか？ ……準備中なので、少しお待ちください。",
      "依頼の受付も、そのうち始めます。",
      "ギルド長にご用ですか？ 右の奥の部屋にいらっしゃいます。"
    ]
  },
  "adv_guild_master": {
    "name": "冒険者ギルドマスター",
    "sdId": 154,
    "texture": "/images/npcs/adv_guild_master.png",
    "height": 2.7,
    "aspect": 0.405,
    "radius": 0.5,
    "speed": 0.0,
    "wanderRadius": 0.0,
    "lines": [
      "冒険者ギルドへようこそ。腕に覚えがあるなら、歓迎するぞ。",
      "無茶はするな。生きて帰るのが一流だ。"
    ]
  },
  "baron_man": {
    "name": "男爵",
    "sdId": 169,
    "texture": "/images/npcs/baron_man.png",
    "height": 2.3,
    "aspect": 0.345,
    "radius": 0.4,
    "speed": 0.5,
    "wanderRadius": 2.0,
    "lines": [
      "男爵と言っても名ばかりでな。それでも、身なりだけは整えているのさ。",
      "古い屋敷でも、家は家だ。"
    ]
  },
  "baron_woman": {
    "name": "男爵夫人",
    "sdId": 170,
    "texture": "/images/npcs/baron_woman.png",
    "height": 2.3,
    "aspect": 0.389,
    "radius": 0.53,
    "speed": 0.5,
    "wanderRadius": 2.0,
    "lines": [
      "このドレスも、もう十年になりますの。直して着ていますのよ。",
      "質素でも、品は保ちたいものですわ。"
    ]
  },
  "cardinal": {
    "name": "枢機卿",
    "sdId": 160,
    "texture": "/images/npcs/cardinal.png",
    "height": 2.4,
    "aspect": 0.665,
    "radius": 0.68,
    "speed": 0.4,
    "wanderRadius": 1.5,
    "lines": [
      "神のご加護があらんことを。……ところで、今夜の予定はあるかね？",
      "年を取ると、信仰より楽しみが増えるものでね。"
    ]
  },
  "duke_man": {
    "name": "公爵",
    "sdId": 176,
    "texture": "/images/npcs/duke_man.png",
    "height": 2.3,
    "aspect": 0.688,
    "radius": 0.55,
    "speed": 0.4,
    "wanderRadius": 1.5,
    "lines": [
      "余に道を譲りたまえ。……ああ、君は誰だったか。",
      "王の兄である余が、なぜ待たされねばならんのだ。"
    ]
  },
  "duke_woman": {
    "name": "公爵夫人",
    "sdId": 177,
    "texture": "/images/npcs/duke_woman.png",
    "height": 2.4,
    "aspect": 0.681,
    "radius": 0.62,
    "speed": 0.5,
    "wanderRadius": 2.0,
    "lines": [
      "この国の民は、みな勤勉ですのね。……少し、うらやましいわ。",
      "政のことは、わたくしには分かりません。"
    ]
  },
  "dwarf_smith": {
    "name": "ドワーフの鍛冶屋",
    "sdId": 166,
    "texture": "/images/npcs/dwarf_smith.png",
    "height": 2.1,
    "aspect": 0.518,
    "radius": 0.52,
    "speed": 0.0,
    "wanderRadius": 0.0,
    "lines": [
      "いい鉄は、いい火で鍛えるもんだ。素材を持ってきたら、見てやろう。",
      "半端な武器は、わしの前に出すな。"
    ]
  },
  "junior_merchant_man": {
    "name": "下っ端商人",
    "sdId": 145,
    "texture": "/images/npcs/junior_merchant_man.png",
    "height": 2.3,
    "aspect": 0.339,
    "radius": 0.41,
    "speed": 0.8,
    "wanderRadius": 2.5,
    "lines": [
      "まだ下っ端ですが、いつかは大商人になってみせますよ！",
      "仕入れが大変でしてね。"
    ]
  },
  "junior_merchant_woman": {
    "name": "下っ端商人の女",
    "sdId": 144,
    "texture": "/images/npcs/junior_merchant_woman.png",
    "height": 2.3,
    "aspect": 0.349,
    "radius": 0.42,
    "speed": 0.8,
    "wanderRadius": 2.5,
    "lines": [
      "いらっしゃいませ！ ……あ、私はまだ見習いなんです。",
      "ギルド長に認められる日を夢見てます。"
    ]
  },
  "mage_clerk_man": {
    "name": "魔法ギルドの受付",
    "sdId": 153,
    "texture": "/images/npcs/mage_clerk_man.png",
    "height": 2.4,
    "aspect": 0.396,
    "radius": 0.43,
    "speed": 0.0,
    "wanderRadius": 0.0,
    "lines": [
      "魔法のお仕事の依頼は、こちらで受け付けます……そのうち。",
      "フードは、癖でして。"
    ]
  },
  "mage_clerk_woman": {
    "name": "魔法ギルドの受付",
    "sdId": 152,
    "texture": "/images/npcs/mage_clerk_woman.png",
    "height": 2.3,
    "aspect": 0.362,
    "radius": 0.43,
    "speed": 0.0,
    "wanderRadius": 0.0,
    "lines": [
      "スクロールのご用ですか？ 魔法ギルドは、まだ準備中なんです。",
      "魔法の知識は、積み重ねが大切ですよ。",
      "ギルド長は、右の奥の部屋にいらっしゃいますよ。"
    ]
  },
  "mage_guild_master": {
    "name": "魔法ギルドマスター",
    "sdId": 156,
    "texture": "/images/npcs/mage_guild_master.png",
    "height": 2.5,
    "aspect": 0.555,
    "radius": 0.6,
    "speed": 0.0,
    "wanderRadius": 0.0,
    "lines": [
      "魔法の探求に終わりはないわ。知識を求めるなら、いつでもいらっしゃい。",
      "力を持つなら、責任も持ちなさい。"
    ]
  },
  "margrave_man": {
    "name": "辺境伯",
    "sdId": 174,
    "texture": "/images/npcs/margrave_man.png",
    "height": 2.5,
    "aspect": 0.486,
    "radius": 0.53,
    "speed": 0.5,
    "wanderRadius": 2.0,
    "lines": [
      "国境を守る身だ。戦のことなら、いつでも相談に乗ろう。",
      "辺境では、剣が礼儀より先に立つのでな。"
    ]
  },
  "margrave_woman": {
    "name": "辺境伯夫人",
    "sdId": 175,
    "texture": "/images/npcs/margrave_woman.png",
    "height": 2.5,
    "aspect": 0.657,
    "radius": 0.59,
    "speed": 0.5,
    "wanderRadius": 2.0,
    "lines": [
      "ふふ、私の腕が気になる？ 組み手なら、いつでも受けて立つわよ。",
      "ドレスは窮屈ね。剣のほうが性に合うわ。"
    ]
  },
  "marquis_man": {
    "name": "侯爵",
    "sdId": 173,
    "texture": "/images/npcs/marquis_man.png",
    "height": 2.3,
    "aspect": 0.359,
    "radius": 0.42,
    "speed": 0.5,
    "wanderRadius": 2.0,
    "lines": [
      "宮廷は退屈でね。たまの散歩が、何よりの楽しみだよ。",
      "王子にも、困ったものだ。"
    ]
  },
  "marquis_woman": {
    "name": "侯爵夫人",
    "sdId": 171,
    "texture": "/images/npcs/marquis_woman.png",
    "height": 2.4,
    "aspect": 0.412,
    "radius": 0.59,
    "speed": 0.5,
    "wanderRadius": 2.0,
    "lines": [
      "ごきげんよう。今日は良い風が吹いていますわね。",
      "街の噴水は、何度見ても飽きませんわ。"
    ]
  },
  "merchant_master_man": {
    "name": "商人ギルドマスター",
    "sdId": 149,
    "texture": "/images/npcs/merchant_master_man.png",
    "height": 2.3,
    "aspect": 0.344,
    "radius": 0.5,
    "speed": 0.0,
    "wanderRadius": 0.0,
    "lines": [
      "ほう、いい目をしておられる。商売の話なら、いくらでも。",
      "ギルドは、信用で成り立っているのですよ。"
    ]
  },
  "merchant_master_woman": {
    "name": "商人ギルドマスターの婦人",
    "sdId": 148,
    "texture": "/images/npcs/merchant_master_woman.png",
    "height": 2.5,
    "aspect": 0.425,
    "radius": 0.59,
    "speed": 0.0,
    "wanderRadius": 0.0,
    "lines": [
      "取引は信用が第一。うちのギルドは、そこだけは譲りませんよ。",
      "油断は禁物。それが商いの鉄則です。"
    ]
  },
  "priest_man": {
    "name": "助祭",
    "sdId": 157,
    "texture": "/images/npcs/priest_man.png",
    "height": 2.3,
    "aspect": 0.369,
    "radius": 0.42,
    "speed": 0.6,
    "wanderRadius": 2.0,
    "lines": [
      "迷える人々のために、今日も祈りを捧げています。",
      "ボランティアが、私の生きがいでして。"
    ]
  },
  "priest_senior": {
    "name": "司祭",
    "sdId": 159,
    "texture": "/images/npcs/priest_senior.png",
    "height": 2.4,
    "aspect": 0.543,
    "radius": 0.57,
    "speed": 0.4,
    "wanderRadius": 1.5,
    "lines": [
      "祈りは大切だが、食事も大切だ。そう思わんかね。",
      "このカツラは……いや、何でもない。"
    ]
  },
  "priest_woman": {
    "name": "修道女",
    "sdId": 158,
    "texture": "/images/npcs/priest_woman.png",
    "height": 2.3,
    "aspect": 0.34,
    "radius": 0.48,
    "speed": 0.6,
    "wanderRadius": 2.0,
    "lines": [
      "困ったことがあれば、教会へ。お話を聞くくらいはできますよ。",
      "皆さまに、神のご加護がありますように。"
    ]
  },
  "senior_merchant_woman": {
    "name": "上級商人の婦人",
    "sdId": 147,
    "texture": "/images/npcs/senior_merchant_woman.png",
    "height": 2.3,
    "aspect": 0.359,
    "radius": 0.41,
    "speed": 0.6,
    "wanderRadius": 2.0,
    "lines": [
      "上等な品ほど、値段の理由があるのですよ。",
      "目利きは、一朝一夕では身につきません。"
    ]
  },
  "town_boy": {
    "name": "街の少年",
    "sdId": 138,
    "texture": "/images/npcs/town_boy.png",
    "height": 1.6,
    "aspect": 0.342,
    "radius": 0.35,
    "speed": 1.3,
    "wanderRadius": 3.0,
    "lines": [
      "ぼくも大きくなったら、冒険者になるんだ！",
      "お城の兵隊さん、かっこいいよね。"
    ]
  },
  "town_girl": {
    "name": "街の少女",
    "sdId": 139,
    "texture": "/images/npcs/town_girl.png",
    "height": 1.55,
    "aspect": 0.344,
    "radius": 0.35,
    "speed": 1.3,
    "wanderRadius": 3.0,
    "lines": [
      "噴水の水が、きらきらしてきれいなの。",
      "お母さんに、お使いを頼まれたの。"
    ]
  },
  "town_man": {
    "name": "街の男",
    "sdId": 136,
    "texture": "/images/npcs/town_man.png",
    "height": 2.3,
    "aspect": 0.455,
    "radius": 0.41,
    "speed": 0.9,
    "wanderRadius": 3.0,
    "lines": [
      "今日も市場は賑わっているな。",
      "最近、冒険者が増えた気がするよ。"
    ]
  },
  "town_middle_man": {
    "name": "街の中年男",
    "sdId": 140,
    "texture": "/images/npcs/town_middle_man.png",
    "height": 2.3,
    "aspect": 0.371,
    "radius": 0.42,
    "speed": 0.8,
    "wanderRadius": 3.0,
    "lines": [
      "仕事帰りの一杯が、何よりの楽しみでね。",
      "この街も、昔は静かだったんだがなあ。"
    ]
  },
  "town_middle_woman": {
    "name": "街の中年女",
    "sdId": 141,
    "texture": "/images/npcs/town_middle_woman.png",
    "height": 2.2,
    "aspect": 0.382,
    "radius": 0.5,
    "speed": 0.8,
    "wanderRadius": 3.0,
    "lines": [
      "うちの子ったら、また遊びに出かけてしまって。",
      "市場で、いい野菜が手に入ったのよ。"
    ]
  },
  "town_old_man": {
    "name": "街の老人",
    "sdId": 143,
