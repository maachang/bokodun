      "城の中では、剣を抜くなよ。"
    ]
  },
  "gate_guard": {
    "name": "城門の衛兵",
    "sdId": 9,
    "texture": "/images/npcs/guard_spear.png",
    "height": 2.6,
    "aspect": 0.373,
    "radius": 0.5,
    "speed": 0.0,
    "wanderRadius": 0.0,
    "lines": [
      "ここは王城の正門だ。陛下に会うなら、静かにな。",
      "王様は……まあ、見ればわかる。",
      "通ってよし。くれぐれも、失礼のないように。"
    ]
  },
  "weapon_keeper": {
