    "texture": "/images/npcs/village_chief.png",
    "height": 2.4,
    "aspect": 0.476,
    "radius": 0.45,
    "speed": 0.7,
    "wanderRadius": 1.0,
    "lines": [
      "よく来た、旅の人。ここは静かで、良い村じゃよ。",
      "南の橋を渡れば、東の草原へ出られる。魔物には気をつけなさい。",
      "わしの家は自由に見ていくがよい。"
    ]
  },
  "villager_man": {
    "name": "村人の男",
    "sdId": 127,
    "texture": "/images/npcs/villager_man.png",
    "height": 2.3,
    "aspect": 0.37,
    "radius": 0.45,
    "speed": 0.9,
    "wanderRadius": 3.0,
    "lines": [
      "今年は畑の出来がいい。",
      "最近、草原で魔物を見たって話だ。"
    ]
  },
