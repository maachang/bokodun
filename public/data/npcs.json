    "aspect": 0.365,
    "radius": 0.35,
    "speed": 1.3,
    "wanderRadius": 3.0,
    "lines": [
      "橋のむこうに行ってみたいなあ。",
      "おにいちゃん、冒険者？ すごい！"
    ]
  },
  "child_girl": {
    "name": "村の女の子",
    "sdId": 130,
    "texture": "/images/npcs/child_girl.png",
    "height": 1.55,
    "aspect": 0.342,
    "radius": 0.35,
    "speed": 1.3,
    "wanderRadius": 3.0,
    "lines": [
      "お花をつんでもいい？ ……だめ？",
      "村長さんは、いつもやさしいんだよ。"
    ]
  },
  "elder_man": {
    "name": "村の老人",
    "sdId": 131,
    "texture": "/images/npcs/elder_man.png",
