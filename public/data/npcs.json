    "aspect": 0.381,
    "radius": 0.45,
    "speed": 0.9,
    "wanderRadius": 3.0,
    "lines": [
      "花壇の花がきれいに咲いたのよ。",
      "川の水は冷たいから、落ちないようにね。"
    ]
  },
  "child_boy": {
    "name": "村の男の子",
    "sdId": 129,
    "texture": "/images/npcs/child_boy.png",
