    "aspect": 0.396,
    "radius": 0.45,
    "speed": 0.5,
    "wanderRadius": 2.0,
    "lines": [
      "わしが若い頃は、この辺りも魔物だらけじゃった。",
      "ほっほっ、元気そうでなによりじゃ。"
    ]
  },
  "elder_woman": {
    "name": "村の老婆",
    "sdId": 132,
    "texture": "/images/npcs/elder_woman.png",
    "height": 2.0,
    "aspect": 0.36,
    "radius": 0.45,
    "speed": 0.5,
    "wanderRadius": 2.0,
    "lines": [
      "おや、旅の人かい。ゆっくりしていきなさい。",
      "腰が痛くてねぇ……天気が崩れるかもしれないよ。"
    ]
  },
  "merchant_man": {
    "name": "商人",
    "sdId": 134,
    "texture": "/images/npcs/merchant_man.png",
    "height": 2.4,
    "aspect": 0.485,
    "radius": 0.6,
    "speed": 0.7,
    "wanderRadius": 2.0,
    "lines": [
      "いい品が入っているよ。……今日は仕入れの途中でね。",
      "おっと、旦那、運がいい。また今度寄っておくれ。"
    ]
  },
  "merchant_woman": {
    "name": "商人の婦人",
    "sdId": 135,
    "texture": "/images/npcs/merchant_woman.png",
    "height": 2.5,
    "aspect": 0.408,
    "radius": 0.6,
    "speed": 0.7,
    "wanderRadius": 2.0,
    "lines": [
      "あたしの目利きは確かだよ。損はさせないさ。",
      "村の外は物騒だからね。準備はしっかりしていきな。"
    ]
  },
  "king": {
    "name": "王様",
    "sdId": 17,
    "texture": "/images/npcs/king.png",
    "height": 2.2,
    "aspect": 1.059,
    "radius": 1.0,
    "speed": 0.0,
    "wanderRadius": 0.0,
    "lines": [
      "ふむ……よくぞ参った、冒険者よ。",
      "わしは腹が減った。……いや、国の行く末が心配なだけじゃ。",
      "税を上げれば宝石が増える。簡単な話じゃろう？"
    ]
  },
  "prince": {
    "name": "王子",
    "sdId": 7,
    "texture": "/images/npcs/prince.png",
    "height": 2.3,
    "aspect": 0.624,
    "radius": 0.7,
    "speed": 0.0,
    "wanderRadius": 0.0,
    "lines": [
      "ぼくは顔がいいから、何をしても許されるんだ。",
      "勉強？ それって、おいしいの？",
      "冒険者かあ。ぼくも魔王を倒してみたいなあ……明日あたり。"
    ]
  },
  "guard_heavy": {
    "name": "重装の衛兵",
    "sdId": 16,
    "texture": "/images/npcs/guard_heavy.png",
