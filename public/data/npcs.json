    "aspect": 0.52,
    "radius": 0.8,
    "speed": 0.5,
    "wanderRadius": 1.0,
    "lines": [
      "陛下の御前だ。静かにしろ。",
      "……この国は、大丈夫なのだろうか。"
    ]
  },
  "guard_spear": {
    "name": "城の衛兵",
    "sdId": 9,
    "texture": "/images/npcs/guard_spear.png",
    "height": 2.6,
    "aspect": 0.373,
    "radius": 0.5,
    "speed": 0.6,
    "wanderRadius": 2.0,
    "lines": [
      "ここは王城だ。無礼は許さんぞ。",
      "怪しい動きをすれば、容赦はしない。"
    ]
  },
  "guard_light": {
    "name": "軽装の衛兵",
    "sdId": 2,
    "texture": "/images/npcs/guard_light.png",
    "height": 2.4,
    "aspect": 0.321,
    "radius": 0.45,
    "speed": 0.6,
    "wanderRadius": 2.0,
    "lines": [
